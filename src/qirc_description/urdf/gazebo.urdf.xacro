<?xml version="1.0"?>
<!--
  Gazebo (Fortress) parts of the robot model. Included by qirc.urdf.xacro
  only with sim:=true, so the real robot's model has none of this.

  Tracks: URDF has no track model, so each track is a row of road wheels
  (collision only, no visual: it still looks like a track) driven by the
  DiffDrive system. Good enough on flat ground for mapping and navigation;
  stair climbing needs the TrackedVehicle system instead (#84).

  Gazebo topics (bridged to ROS by qirc_gazebo/config/bridge.yaml):
    /cmd_vel        in   geometry_msgs/Twist
    /joint_states   out  wheel joints, for robot_state_publisher
    /scan           out  sensor_msgs/LaserScan in frame laser, like rplidar_ros
    /front_camera/image, /front_camera/depth_image, /front_camera/camera_info
                    out  the D435i's colour image and aligned depth; bridged
                         to realsense2_camera's topic names
    /front_camera/imu
                    out  sensor_msgs/Imu, gyro and accelerometer, like the D435i
    /ground_truth   out  nav_msgs/Odometry, the robot's true pose in the world
                         (for measuring localization error)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== Road wheels ===================================================== -->
  <!-- Wheels per track, spread evenly between the two sprocket centres. -->
  <xacro:property name="road_wheel_count" value="4"/>
  <xacro:property name="road_wheel_mass" value="0.2"/>
  <!-- Friction against the ground. Skid-steer turning drags the wheels
       sideways, so too much friction makes turning on the spot stall. -->
  <xacro:property name="road_wheel_mu" value="0.8"/>

  <!-- Effective track separation for DiffDrive = physical separation x this.
       Skid-steer tracks turn less than their wheel speeds suggest, because
       the wheels slide sideways: with the physical separation, the robot
       turned 1.40x slower than commanded. With this factor it turns at the
       commanded rate (to within ~3 degrees per half turn), so /cmd_vel means
       the same in simulation as it should on the robot. Re-measure if
       road_wheel_mu or the wheel layout changes. -->
  <xacro:property name="track_skid_factor" value="1.40"/>

  <!-- Wheel radius = track radius, so the wheels touch the ground exactly
       where the track bottom is (z = 0). -->
  <xacro:property name="road_wheel_radius" value="${track_radius}"/>
  <xacro:property name="road_wheel_spacing"
                  value="${track_straight / (road_wheel_count - 1)}"/>

  <xacro:macro name="road_wheel" params="side i">
    <link name="${side}_wheel_${i}_link">
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${road_wheel_radius}" length="${track_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${road_wheel_mass}"/>
        <!-- Solid cylinder whose axis is y. -->
        <inertia ixx="${road_wheel_mass * (3 * road_wheel_radius ** 2 + track_width ** 2) / 12}"
                 ixy="0" ixz="0"
                 iyy="${road_wheel_mass * road_wheel_radius ** 2 / 2}"
                 iyz="0"
                 izz="${road_wheel_mass * (3 * road_wheel_radius ** 2 + track_width ** 2) / 12}"/>
      </inertial>
    </link>

    <joint name="${side}_wheel_${i}_joint" type="continuous">
      <parent link="${side}_track_link"/>
      <child link="${side}_wheel_${i}_link"/>
      <origin xyz="${-track_straight / 2 + i * road_wheel_spacing} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${side}_wheel_${i}_link">
      <mu1>${road_wheel_mu}</mu1>
      <mu2>${road_wheel_mu}</mu2>
    </gazebo>
  </xacro:macro>

  <!-- Wheels i = n-1 ... 0 of one track (xacro has no loops). -->
  <xacro:macro name="road_wheels" params="side i">
    <xacro:road_wheel side="${side}" i="${i}"/>
    <xacro:if value="${i > 0}">
      <xacro:road_wheels side="${side}" i="${i - 1}"/>
    </xacro:if>
  </xacro:macro>

  <!-- <left_joint> / <right_joint> entries for every wheel of one track. -->
  <xacro:macro name="diff_drive_joints" params="side i">
    <xacro:element xacro:name="${side}_joint">${side}_wheel_${i}_joint</xacro:element>
    <xacro:if value="${i > 0}">
      <xacro:diff_drive_joints side="${side}" i="${i - 1}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:road_wheels side="left" i="${road_wheel_count - 1}"/>
  <xacro:road_wheels side="right" i="${road_wheel_count - 1}"/>

  <!-- ===== LiDAR =========================================================== -->
  <!-- RPLIDAR A2M8, set up like the real driver (rplidar_ros, lidar.yaml):
       360 degrees, 10 Hz, 8000 samples/s -> 800 per scan, 0.15-12 m. -->
  <xacro:property name="lidar_rate" value="10"/>
  <xacro:property name="lidar_samples" value="800"/>
  <xacro:property name="lidar_min_range" value="0.15"/>
  <xacro:property name="lidar_max_range" value="12.0"/>
  <xacro:property name="lidar_noise" value="0.01"/>   <!-- stddev, m -->

  <gazebo reference="laser">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <!-- The laser link is merged into base_link when the URDF becomes
           SDF (fixed joint), so name the frame explicitly. -->
      <ignition_frame_id>laser</ignition_frame_id>
      <update_rate>${lidar_rate}</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <!-- -180 to just under +180 degrees, so no ray is repeated. -->
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi - 2 * pi / lidar_samples}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar_min_range}</min>
          <max>${lidar_max_range}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>${lidar_noise}</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===== Front camera: RealSense D435i ==================================== -->
  <!-- Set up like the real camera with qirc_perception/config/front_camera.yaml,
       so the same nodes run on both. Specs from Intel's D400 datasheet.

       Frames: on the real robot, realsense2_camera publishes the frames below
       front_camera_link itself (as front_camera_*, once camera_name is set,
       #22). In simulation they are here instead, at the offsets from Intel's
       realsense2_description (_d435.urdf.xacro, _d435i_imu_modules.urdf.xacro),
       which treats front_camera_link as the depth camera's origin. -->
  <xacro:property name="d435i_color_y" value="0.015"/>   <!-- depth -> colour -->
  <xacro:property name="d435i_imu_xyz" value="-0.01174 -0.00552 0.0051"/>
  <!-- From an x-forward frame to an optical frame (z forward, x right, y down). -->
  <xacro:property name="optical_rpy" value="${-pi / 2} 0 ${-pi / 2}"/>

  <!-- Colour image and depth aligned to it (align_depth: true), 848x480 at
       30 fps. Gazebo's RGB-D camera has one field of view for both, the
       colour camera's: aligned depth is cropped to it on the real camera too. -->
  <xacro:property name="d435i_width" value="848"/>
  <xacro:property name="d435i_height" value="480"/>
  <xacro:property name="d435i_rate" value="30"/>
  <xacro:property name="d435i_hfov" value="${69.4 * pi / 180}"/>  <!-- 69.4 x 42 deg -->
  <!-- Min-Z at 848x480 (datasheet table 4-11); depth is usable to about 10 m. -->
  <xacro:property name="d435i_depth_min" value="0.195"/>
  <xacro:property name="d435i_depth_max" value="10.0"/>
  <xacro:property name="d435i_image_noise" value="0.007"/>  <!-- stddev, 0-1 -->

  <!-- IMU: BMI055 (BMI085 in newer units), reported as one sensor_msgs/Imu at
       the gyro rate (unite_imu_method: 2). The driver publishes no
       orientation. Noise from Bosch's noise densities (gyro 0.014 deg/s/rtHz,
       accel 150 ug/rtHz) over ~half the output rate.
       The gyro bias is an ESTIMATE until it is measured on the real camera
       (#31): it is drawn at random for each run, and qirc_localization's
       imu_bias node removes it while the robot stands still. -->
  <xacro:property name="d435i_imu_rate" value="200"/>
  <xacro:property name="d435i_gyro_noise" value="0.0024"/>   <!-- rad/s -->
  <xacro:property name="d435i_gyro_bias" value="0.009"/>     <!-- rad/s, ~0.5 deg/s -->
  <xacro:property name="d435i_accel_noise" value="0.01"/>    <!-- m/s^2 -->
  <xacro:property name="d435i_accel_bias" value="0.05"/>     <!-- m/s^2 -->

  <link name="front_camera_color_frame"/>
  <joint name="front_camera_color_joint" type="fixed">
    <parent link="front_camera_link"/>
    <child link="front_camera_color_frame"/>
    <origin xyz="0 ${d435i_color_y} 0" rpy="0 0 0"/>
  </joint>
  <link name="front_camera_color_optical_frame"/>
  <joint name="front_camera_color_optical_joint" type="fixed">
    <parent link="front_camera_color_frame"/>
    <child link="front_camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${optical_rpy}"/>
  </joint>
  <link name="front_camera_imu_frame"/>
  <joint name="front_camera_imu_joint" type="fixed">
    <parent link="front_camera_link"/>
    <child link="front_camera_imu_frame"/>
    <origin xyz="${d435i_imu_xyz}" rpy="0 0 0"/>
  </joint>
  <link name="front_camera_imu_optical_frame"/>
  <joint name="front_camera_imu_optical_joint" type="fixed">
    <parent link="front_camera_imu_frame"/>
    <child link="front_camera_imu_optical_frame"/>
    <origin xyz="0 0 0" rpy="${optical_rpy}"/>
  </joint>

  <xacro:macro name="imu_noise" params="stddev bias">
    <noise type="gaussian">
      <mean>0</mean>
      <stddev>${stddev}</stddev>
      <bias_mean>0</bias_mean>
      <bias_stddev>${bias}</bias_stddev>
    </noise>
  </xacro:macro>

  <!-- Sensor poses are relative to front_camera_link (the frames above have
       no mass, so Gazebo merges them into it). -->
  <gazebo reference="front_camera_link">
    <!-- Gazebo cameras look along the sensor's x; the images are labelled
         with the optical frame, like the driver's. -->
    <sensor name="front_camera" type="rgbd_camera">
      <pose>0 ${d435i_color_y} 0 0 0 0</pose>
      <topic>/front_camera</topic>
      <ignition_frame_id>front_camera_color_optical_frame</ignition_frame_id>
      <update_rate>${d435i_rate}</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>${d435i_hfov}</horizontal_fov>
        <image>
          <width>${d435i_width}</width>
          <height>${d435i_height}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>${d435i_depth_max}</far>
        </clip>
        <depth_camera>
          <clip>
            <near>${d435i_depth_min}</near>
            <far>${d435i_depth_max}</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>${d435i_image_noise}</stddev>
        </noise>
      </camera>
    </sensor>

    <!-- Rotated like the optical frame, so the readings are in the same axes
         as the real IMU's (front_camera_imu_optical_frame). -->
    <sensor name="front_camera_imu" type="imu">
      <pose>${d435i_imu_xyz} ${optical_rpy}</pose>
      <topic>/front_camera/imu</topic>
      <ignition_frame_id>front_camera_imu_optical_frame</ignition_frame_id>
      <update_rate>${d435i_imu_rate}</update_rate>
      <always_on>true</always_on>
      <imu>
        <enable_orientation>false</enable_orientation>
        <angular_velocity>
          <x><xacro:imu_noise stddev="${d435i_gyro_noise}" bias="${d435i_gyro_bias}"/></x>
          <y><xacro:imu_noise stddev="${d435i_gyro_noise}" bias="${d435i_gyro_bias}"/></y>
          <z><xacro:imu_noise stddev="${d435i_gyro_noise}" bias="${d435i_gyro_bias}"/></z>
        </angular_velocity>
        <linear_acceleration>
          <x><xacro:imu_noise stddev="${d435i_accel_noise}" bias="${d435i_accel_bias}"/></x>
          <y><xacro:imu_noise stddev="${d435i_accel_noise}" bias="${d435i_accel_bias}"/></y>
          <z><xacro:imu_noise stddev="${d435i_accel_noise}" bias="${d435i_accel_bias}"/></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ===== Systems ========================================================= -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <xacro:diff_drive_joints side="left" i="${road_wheel_count - 1}"/>
      <xacro:diff_drive_joints side="right" i="${road_wheel_count - 1}"/>
      <!-- Effective separation: track centre to track centre, widened for
           skid (see track_skid_factor). -->
      <wheel_separation>${2 * track_y * track_skid_factor}</wheel_separation>
      <wheel_radius>${road_wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <!-- DiffDrive only moves the robot. Its wheel odometry isn't bridged
           to ROS: the robot has no drive encoders, so the stack gets its
           odometry from the LiDAR, as on the real robot. -->
    </plugin>

    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

    <!-- The robot's true pose in the world, for measuring localization
         error (not something the real robot has). Its TF isn't bridged:
         it would clash with the robot's own odom -> base_link. -->
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/ground_truth</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>

</robot>
