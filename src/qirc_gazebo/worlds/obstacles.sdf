<?xml version="1.0"?>
<!--
  Test world: the empty world plus a few walls and boxes, all taller than
  the LiDAR scan plane, so /scan has something to see. The house world is #28.
  Gazebo Fortress (SDF 1.8). Start it with:
    ros2 launch qirc_gazebo sim.launch.py world:=obstacles.sdf
-->
<sdf version="1.8">
  <world name="obstacles">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- Renders the robot's sensors (the GPU LiDAR needs ogre2). -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Needed by the IMU in the D435i. -->
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>4.0 0.0 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 6.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 6.0 1.0</size></box></geometry>
          <material>
            <ambient>0.4 0.5 0.7 1</ambient>
            <diffuse>0.4 0.5 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>0.0 3.0 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.0 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.2 1.0</size></box></geometry>
          <material>
            <ambient>0.4 0.5 0.7 1</ambient>
            <diffuse>0.4 0.5 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_near">
      <static>true</static>
      <pose>1.5 -1.0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.4 0.5 0.7 1</ambient>
            <diffuse>0.4 0.5 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_far">
      <static>true</static>
      <pose>2.5 1.2 0.25 0 0 0.6</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
          <material>
            <ambient>0.4 0.5 0.7 1</ambient>
            <diffuse>0.4 0.5 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_behind">
      <static>true</static>
      <pose>-2.0 -0.5 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.8 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.8 0.5</size></box></geometry>
          <material>
            <ambient>0.4 0.5 0.7 1</ambient>
            <diffuse>0.4 0.5 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
