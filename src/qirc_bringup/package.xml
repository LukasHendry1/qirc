<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qirc_bringup</name>
  <version>0.0.0</version>
  <description>Top-level launch files and parameters</description>
  <maintainer email="lukas.hendry15@gmail.com">Lukas Hendry</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>qirc_perception</exec_depend>
  <exec_depend>qirc_localization</exec_depend>
  <exec_depend>qirc_planning</exec_depend>
  <exec_depend>qirc_control</exec_depend>
  <exec_depend>qirc_pill_dispenser</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
